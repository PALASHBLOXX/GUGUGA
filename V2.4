
:root {
  --bg: #05080d;
  --panel: #0b111b;
  --panel2: #0e1724;
  --blue: #00bfff;
  --blue2: #168bff;
  --text: #edf7ff;
  --muted: #8294a9;
  --border: #17283b;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Inter', sans-serif;
  min-height: 100vh;
}

button, input {
  font: inherit;
}

button {
  color: inherit;
}

button:focus-visible,
input:focus-visible,
.upload-btn:focus-within {
  outline: 2px solid var(--blue);
  outline-offset: 4px;
}

.app {
  width: min(1440px, 100%);
  margin: auto;
  padding: 0 36px;
}

.topbar {
  min-height: 85px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--border);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--text);
  text-decoration: none;
  font-size: 19px;
  font-weight: 800;
  letter-spacing: 1px;
}

.brand-icon {
  display: grid;
  place-items: center;
  width: 39px;
  height: 39px;
  border-radius: 12px;
  background: var(--blue);
  color: #001018;
  font-size: 27px;
  box-shadow: 0 0 24px #00bfff40;
}

.blue, .welcome h1 span, .section-heading h2 span {
  color: var(--blue);
}

.status {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 10px;
  color: var(--muted);
  letter-spacing: 1.5px;
}

.status span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #30e8a0;
  box-shadow: 0 0 12px #30e8a0;
}

.layout {
  display: grid;
  grid-template-columns: 215px minmax(0, 1fr);
  gap: 38px;
  padding: 34px 0 50px;
}

.sidebar {
  position: relative;
  min-height: 650px;
  padding: 15px 0;
  border-right: 1px solid var(--border);
}

.section-label, .eyebrow {
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 2px;
  font-weight: 700;
}

.section-label {
  margin-bottom: 20px;
}

.nav-item {
  width: calc(100% - 18px);
  padding: 15px;
  margin: 4px 0;
  text-align: left;
  border: 1px solid transparent;
  border-radius: 10px;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  transition: .2s;
}

.nav-item:hover, .nav-item.active {
  color: var(--blue);
  background: #00bfff0c;
  border-color: #00bfff25;
}

.sidebar-bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 18px;
  padding: 22px 15px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: linear-gradient(145deg, #0d1827, #080c13);
}

.sidebar-bottom p {
  font-size: 10px;
  letter-spacing: 1px;
  margin: 16px 0 7px;
}

.sidebar-bottom small {
  color: var(--muted);
  font-size: 11px;
}

.mini-equalizer {
  display: flex;
  align-items: center;
  gap: 5px;
  height: 25px;
}

.mini-equalizer i {
  width: 4px;
  height: 14px;
  border-radius: 4px;
  background: var(--blue);
  animation: equalize .8s infinite alternate ease-in-out;
}

.mini-equalizer i:nth-child(2) { animation-delay: .2s; }
.mini-equalizer i:nth-child(3) { height: 23px; animation-delay: .4s; }
.mini-equalizer i:nth-child(4) { animation-delay: .1s; }
.mini-equalizer i:nth-child(5) { height: 19px; animation-delay: .3s; }

@keyframes equalize {
  to { height: 5px; }
}

.content {
  min-width: 0;
}

.welcome {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 30px;
}

.welcome h1 {
  margin: 13px 0 10px;
  font-size: clamp(27px, 3.3vw, 43px);
  line-height: 1.15;
  letter-spacing: -1.8px;
}

.subtext {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}

.upload-btn {
  flex-shrink: 0;
  padding: 13px 18px;
  border-radius: 9px;
  background: var(--blue);
  color: #001018;
  font-weight: 700;
  font-size: 12px;
  cursor: pointer;
  transition: .2s;
}

.upload-btn:hover, .play-btn:hover {
  background: #75ddff;
  box-shadow: 0 0 25px #00bfff50;
  transform: translateY(-2px);
}

.player-card {
  display: grid;
  grid-template-columns: minmax(190px, .85fr) minmax(0, 1.15fr);
  gap: clamp(22px, 4vw, 46px);
  align-items: center;
  padding: clamp(18px, 3vw, 34px);
  border: 1px solid #18344c;
  border-radius: 20px;
  background:
    radial-gradient(ellipse at 5% 5%, #00bfff12, transparent 50%),
    linear-gradient(140deg, #0e1724, #090e16 75%);
  box-shadow: 0 18px 70px #00000025;
}

.cover-wrap {
  min-width: 0;
}

.cover {
  position: relative;
  display: grid;
  place-items: center;
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 15px;
  background:
    radial-gradient(circle at 50% 45%, #0879b9 0, #06426e 18%, transparent 43%),
    radial-gradient(circle at 50% 50%, #102d52, #070d18 70%);
  border: 1px solid #1679ac60;
  box-shadow: inset 0 0 50px #00bfff18, 0 0 35px #00bfff10;
}

.cover::before, .cover::after {
  content: "";
  position: absolute;
  width: 140%;
  height: 1px;
  background: #00bfff70;
  box-shadow: 0 0 15px var(--blue);
  transform: rotate(-38deg);
}

.cover::after {
  transform: rotate(38deg);
}

.cover-orbit {
  position: absolute;
  width: 64%;
  aspect-ratio: 1;
  border: 1px solid #00bfff70;
  border-radius: 50%;
  box-shadow: 0 0 24px #00bfff16;
}

.orbit-two {
  width: 42%;
  border-color: #66d9ff;
  animation: rotate 12s linear infinite;
}

@keyframes rotate {
  to { transform: rotate(360deg); }
}

.cover-center {
  z-index: 1;
  display: grid;
  place-items: center;
  width: 76px;
  height: 76px;
  border-radius: 50%;
  background: #041421;
  border: 1px solid var(--blue);
  color: var(--blue);
  font-size: 40px;
  box-shadow: 0 0 30px #00bfff70;
}

.cover-caption {
  position: absolute;
  left: 15px;
  bottom: 13px;
  z-index: 1;
  font-size: 10px;
  line-height: 1.5;
  font-weight: 800;
  letter-spacing: 3px;
}

.playing-tag {
  display: block;
  margin-top: 15px;
  color: var(--blue);
  font-size: 9px;
  letter-spacing: 2px;
}

.player-info {
  min-width: 0;
}

.player-info h2 {
  margin: 14px 0 7px;
  font-size: clamp(20px, 2.4vw, 29px);
  overflow-wrap: anywhere;
}

.artist {
  color: var(--muted);
  font-size: 13px;
  overflow-wrap: anywhere;
}

.progress-area {
  margin-top: 29px;
}

input[type="range"] {
  accent-color: var(--blue);
  cursor: pointer;
}

#progress {
  width: 100%;
  height: 4px;
  display: block;
}

.time-row {
  display: flex;
  justify-content: space-between;
  margin-top: 10px;
  color: var(--muted);
  font-size: 10px;
  font-variant-numeric: tabular-nums;
}

.controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin: 25px 0;
}

.icon-btn, .play-btn {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  border: none;
  cursor: pointer;
  transition: .2s;
}

.icon-btn {
  width: 32px;
  height: 36px;
  background: transparent;
  color: #9ab0c6;
  border-radius: 8px;
  font-size: 16px;
}

.icon-btn:hover, .icon-btn.selected {
  color: var(--blue);
  background: #00bfff12;
}

.play-btn {
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: var(--blue);
  color: #001018;
  font-size: 20px;
  padding-left: 3px;
  box-shadow: 0 0 28px #00bfff30;
}

.volume-row {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--blue);
  font-size: 13px;
}

.volume-row input {
  width: 100%;
  min-width: 0;
}

.volume-row span:last-child {
  min-width: 34px;
  text-align: right;
  font-size: 10px;
  color: var(--muted);
}

.playlist-section {
  margin-top: 38px;
}

.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 20px;
}

.section-heading h2 {
  margin-top: 10px;
  font-size: 21px;
}

.section-heading h2 span {
  font-size: 12px;
  margin-left: 6px;
}

.playlist-hint {
  font-size: 9px;
  letter-spacing: 1px;
  color: var(--muted);
}

.track-list {
  display: grid;
  gap: 7px;
}

.track {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
  padding: 13px;
  border: 1px solid transparent;
  border-radius: 12px;
  background: #0a1019;
  transition: .2s;
}

.track:hover, .track.current {
  background: #0d1926;
  border-color: #123750;
}

.track.current .track-title {
  color: var(--blue);
}

.track-number {
  width: 22px;
  flex-shrink: 0;
  text-align: center;
  color: var(--muted);
  font-size: 12px;
}

.track-art {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  width: 43px;
  height: 43px;
  border-radius: 9px;
  color: var(--blue);
  background: linear-gradient(135deg, #123654, #101522);
  font-size: 22px;
}

.track-meta {
  flex: 1;
  min-width: 0;
}

.track-title {
  font-size: 12px;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.track-artist {
  margin-top: 5px;
  font-size: 10px;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.track-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.track-duration {
  color: var(--muted);
  font-size: 10px;
  white-space: nowrap;
}

.heart-btn, .track-play {
  padding: 5px;
  border: none;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  font-size: 16px;
}

.heart-btn.liked, .heart-btn:hover, .track-play:hover {
  color: var(--blue);
}

.empty-state {
  padding: 38px 15px;
  text-align: center;
  border: 1px dashed #1c3045;
  border-radius: 14px;
}

.empty-state > span {
  color: var(--blue);
  font-size: 35px;
}

.empty-state h3 {
  margin: 12px 0 8px;
  font-size: 14px;
}

.empty-state p {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.7;
}

.footer {
  min-height: 65px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 1px;
}

@media (min-width: 1100px) {
  .player-card {
    grid-template-columns: minmax(230px, .8fr) minmax(0, 1.2fr);
  }
}

@media (max-width: 850px) {
  .app {
    padding: 0 22px;
  }

  .layout {
    grid-template-columns: 1fr;
    gap: 22px;
    padding-top: 24px;
  }

  .sidebar {
    min-height: auto;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0 0 12px;
    overflow-x: auto;
    border-right: 0;
    border-bottom: 1px solid var(--border);
  }

  .section-label, .sidebar-bottom {
    display: none;
  }

  .nav-item {
    width: auto;
    white-space: nowrap;
    padding: 11px 14px;
    margin: 0;
  }
}

@media (max-width: 560px) {
  .app {
    padding: 0 15px;
  }

  .topbar {
    min-height: 70px;
  }

  .brand {
    font-size: 16px;
  }

  .brand-icon {
    width: 34px;
    height: 34px;
  }

  .status {
    font-size: 8px;
    letter-spacing: .5px;
  }

  .welcome {
    align-items: flex-start;
    flex-direction: column;
    gap: 17px;
  }

  .welcome h1 {
    font-size: 31px;
  }

  .upload-btn {
    padding: 12px 15px;
  }

  .player-card {
    grid-template-columns: 1fr;
    gap: 24px;
    padding: 18px;
  }

  .cover-wrap {
    width: min(100%, 300px);
    margin: auto;
  }

  .player-info h2 {
    font-size: 24px;
  }

  .controls {
    max-width: 360px;
    margin: 23px auto;
  }

  .section-heading h2 {
    font-size: 19px;
  }

  .playlist-hint {
    display: none;
  }

  .track {
    gap: 9px;
    padding: 10px 8px;
  }

  .track-art {
    width: 37px;
    height: 37px;
  }

  .track-actions {
    gap: 5px;
  }

  .footer {
    font-size: 8px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
  }
}
